rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validOptionalBirthTime(data) {
      return data.birthTimeMinutes == null || (data.birthTimeMinutes is int && data.birthTimeMinutes >= 0 && data.birthTimeMinutes <= 1439);
    }
    function validOptionalUtcOffset(data) {
      return data.birthUtcOffsetMinutes == null || (data.birthUtcOffsetMinutes is int && data.birthUtcOffsetMinutes >= -840 && data.birthUtcOffsetMinutes <= 840);
    }
    function validOptionalBirthPlace(data) {
      return data.birthPlace == null || (data.birthPlace is string && data.birthPlace.size() <= 200);
    }
    function validOptionalCoordinates(data) {
      return (data.birthLatitude == null || (data.birthLatitude is number && data.birthLatitude >= -90 && data.birthLatitude <= 90)) && (data.birthLongitude == null || (data.birthLongitude is number && data.birthLongitude >= -180 && data.birthLongitude <= 180));
    }
    function isValidProfile(data) {
      return data.keys().hasAll(['profileSchemaVersion','updatedAt','firstName','dob','sex','weightKg','heightCm','units','guidanceMode','birthTimeMinutes','birthUtcOffsetMinutes','birthPlace','birthLatitude','birthLongitude']) && data.keys().hasOnly(['profileSchemaVersion','updatedAt','firstName','dob','sex','weightKg','heightCm','units','guidanceMode','birthTimeMinutes','birthUtcOffsetMinutes','birthPlace','birthLatitude','birthLongitude']) && data.profileSchemaVersion is int && data.profileSchemaVersion == 1 && data.updatedAt is timestamp && data.firstName is string && data.firstName.size() <= 80 && data.dob is string && data.dob.size() >= 10 && data.dob.size() <= 40 && data.sex in ['female','male','other'] && data.weightKg is number && data.weightKg >= 20 && data.weightKg <= 500 && data.heightCm is number && data.heightCm >= 80 && data.heightCm <= 260 && data.units in ['metric','imperial'] && data.guidanceMode in ['grounded','balanced','immersive'] && validOptionalBirthTime(data) && validOptionalUtcOffset(data) && validOptionalBirthPlace(data) && validOptionalCoordinates(data);
    }
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }
    match /{document=**} { allow read, write: if false; }
  }
}