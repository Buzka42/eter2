rules_version = '2';

// The mirror's server-side half.
//
// The client scopes every path to users/{uid}; these rules make that a
// guarantee rather than a convention. Nobody reads or writes anything but
// their own, and the shapes are bounded so a compromised client cannot turn
// the mirror into arbitrary storage.
//
// Deliberately permissive about *values* and strict about *ownership and
// size*. Validating that a weight is between 20 and 500 here would duplicate
// a rule the app already enforces and would silently break the mirror the day
// the app's own bounds change; refusing another person's document, or a
// megabyte of prose, is the part only the server can do.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A document nobody could have meant: unbounded, or carrying a field
    // count no shape in the app produces.
    function isReasonable() {
      return request.resource.data.keys().size() <= 40;
    }

    function isShortText(value) {
      return value == null || (value is string && value.size() <= 20000);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // The parent document is not written by the client; everything lives in
      // the subcollections below.
      allow write: if false;

      match /profile/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.dob is string
          && request.resource.data.sex in ['female', 'male', 'other']
          && request.resource.data.weightKg is number
          && request.resource.data.units in ['metric', 'imperial']
          // Null is a value here: it means nobody has chosen, and a device
          // restoring a null follows its own phone. Keep in step with
          // `AppLanguage` -- adding a language means adding it here too.
          && (request.resource.data.language == null
              || request.resource.data.language in ['en', 'pl']);
      }

      match /weights/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.kg is number
          && request.resource.data.recordedAt is string;
      }

      match /nutrition/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.kcal is number
          && request.resource.data.meal is string
          && request.resource.data.meal.size() <= 500;
      }

      match /lifestyle/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.kind is string
          && isShortText(request.resource.data.get('note', null));
      }

      match /sessions/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.startUtc is string
          && request.resource.data.endUtc is string;
      }

      match /strength/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.startedAt is string
          && isShortText(request.resource.data.exercisesJson);
      }

      match /days/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }

      // The journal is the most personal thing here, and it only ever arrives
      // under its own separate consent. The rule cannot see that consent, so
      // it does what it can: your own pages, bounded.
      match /journal/{document} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && isReasonable()
          && request.resource.data.createdAt is string
          && isShortText(request.resource.data.text);
      }
    }

    // Anything not named above is denied, including collections a future
    // version might add and forget to write a rule for.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
