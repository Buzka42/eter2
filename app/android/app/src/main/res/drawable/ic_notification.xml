<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar mark for the evening invitation.

     Not `@mipmap/ic_launcher`. Android draws a notification's small icon as an
     alpha mask and tints it itself, so a full-colour adaptive icon arrives as a
     white blob — the shape is lost and the launcher's ground becomes the whole
     glyph.

     So this is the launcher mark reduced to the part that survives at 24dp:
     the arc and the plumb hanging from its centre. The wordmark, the sun and
     the moon are all illegible at this size and are left out rather than
     rendered as three grey specks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- The arc. Shallow, because the mark's arc is nearly flat and a deeper
         one reads as a smile. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M3.5,13.5 Q12,5.5 20.5,13.5" />

    <!-- The plumb: a short thread from the arc's centre, and its weight. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,9.6 L12,16.4" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,17.2 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0" />
</vector>
