<?xml version="1.0" encoding="utf-8"?>
<!--
  The two controls' ground.

  A hairline rather than a filled button: the rest of the product states an
  action with a rule under it and never with a slab of colour, and a widget is
  the last place to break that — it sits among other apps' icons and the only
  thing keeping it Eter's is the restraint.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#12FFFFFF" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
    <corners android:radius="10dp" />
</shape>
