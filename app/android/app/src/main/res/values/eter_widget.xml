<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The same night ground the launcher icon is sampled from, so the widget
         and the icon sit on a home screen as one thing. -->
    <color name="eter_widget_ground">#04162E</color>
    <color name="eter_widget_ink">#ECE7DE</color>
    <color name="eter_widget_ink_muted">#8A93A6</color>

    <!-- Never translated: the product is called Eter in every language and the
         wordmark is drawn type rather than copy. -->
    <string name="eter_widget_mark" translatable="false">ETER</string>
    <string name="eter_widget_label">Eter</string>
    <string name="eter_widget_description">Today\'s sentence from Eter</string>
    <!-- Shown only in the widget picker, and never a real reading. -->
    <string name="eter_widget_preview_line">One sentence of the day, and nothing else.</string>

    <!-- The two ways in from the home screen. -->
    <string name="eter_widget_speak">Speak</string>
    <string name="eter_widget_write">Write</string>
    <string name="eter_widget_speak_description">Record a journal entry by voice</string>
    <string name="eter_widget_write_description">Write a journal entry</string>
</resources>
