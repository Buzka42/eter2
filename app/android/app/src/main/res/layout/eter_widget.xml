<?xml version="1.0" encoding="utf-8"?>
<!--
  One sentence, and the mark under it.

  No counts, no controls, no progress. A widget showing a step total would be a
  scoreboard on somebody's home screen, which is the register this product
  exists not to have — and a widget with a button in it is a button people press
  by accident while tidying their phone.

  The whole surface is the tap target and it opens the app, which is the only
  thing it does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eter_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/eter_widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/eter_widget_sentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/eter_widget_ink"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.35"
        android:fontFamily="serif"
        android:maxLines="5"
        android:ellipsize="end"
        android:contentDescription="@string/eter_widget_description" />

    <TextView
        android:id="@+id/eter_widget_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/eter_widget_mark"
        android:textColor="@color/eter_widget_ink_muted"
        android:textSize="10sp"
        android:letterSpacing="0.3"
        android:fontFamily="sans-serif" />

</LinearLayout>
