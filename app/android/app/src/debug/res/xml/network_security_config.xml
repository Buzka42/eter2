<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Lets a debug build reach `tool/dev_endpoint.dart` running on the
  development machine — 10.0.2.2 is how the Android emulator addresses its
  host, and localhost covers a device with `adb reverse` set up.

  Cleartext stays off everywhere else, and this file is not part of the
  release manifest at all: a release build cannot reach a cleartext endpoint
  even if one were configured, which is the point.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
